# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/surveydb?retryWrites=true&w=majority

# Server-side reflection generation (configure these in Vercel, never in Vite variables)
OPENAI_API_KEY=replace-with-server-side-key
OPENAI_REFLECTION_MODEL=replace-with-supported-model
OPENAI_REFLECTION_TIMEOUT_MS=12000
